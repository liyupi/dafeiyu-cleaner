{
  "manifest_version": 3,
  "name": "大肥鱼消除计划",
  "short_name": "大肥鱼消除计划",
  "version": "1.2.0",
  "description": "鲸鱼娘清道夫上岗！识别 B 站评论区和空间主页的 AI 大肥鱼账号，标记、折叠、响指清场，赶它们回家吃白饭。可选 DeepSeek 精判。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "大肥鱼消除计划",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "snap": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "响指清场（当前页面）"
    },
    "cannon": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "打开泡泡大炮"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.deepseek.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://live.bilibili.com/*",
        "https://message.bilibili.com/*",
        "https://passport.bilibili.com/*",
        "https://member.bilibili.com/*"
      ],
      "js": [
        "src/main-world.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.bilibili.com/*"
      ],
      "exclude_matches": [
        "https://live.bilibili.com/*",
        "https://message.bilibili.com/*",
        "https://passport.bilibili.com/*",
        "https://member.bilibili.com/*"
      ],
      "js": [
        "src/icons.js",
        "src/mascot.js",
        "src/memes.js",
        "src/storage.js",
        "src/detector.js",
        "src/fx.js",
        "src/actors.js",
        "src/weapons.js",
        "src/ui.js",
        "src/comments.js",
        "src/space.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/dfy-display.woff2",
        "assets/actors/*.webp",
        "assets/weapons/*.webp"
      ],
      "matches": [
        "https://*.bilibili.com/*"
      ]
    }
  ]
}